      }
    },
    "Also tells Ottai when your sensor connects, disconnects, or reports a problem." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也会在传感器连接、断开或报告问题时通知欧态。"
          }
        }
      }
    },
    "Also uploads your glucose readings, exactly as the official app does. Allows your doctor/caregivers to keep following your treatment." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
