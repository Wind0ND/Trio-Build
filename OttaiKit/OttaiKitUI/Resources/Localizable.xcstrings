{
  "sourceLanguage" : "en",
  "strings" : {
    "If the sensor is already linked to an Ottai account, sign in with that account to add it to Trio." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果传感器已绑定欧态账号，请登录原绑定账号，再将它添加到 Trio。"
          }
        }
      }
    },
    "If the sensor is asleep, hold the top of the iPhone near it to wake it with NFC." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果传感器处于休眠，将 iPhone 顶部靠近传感器，用 NFC 唤醒。"
          }
        }
      }
    },
    "NFC only wakes the sensor. Pairing still checks its Bluetooth address." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFC 只负责唤醒传感器。配对时仍需核对其蓝牙地址。"
          }
        }
      }
    },
    "Only previously used sensors were heard. Replace the sensor or scan its applicator." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只找到已使用过的传感器。请换用新传感器，或扫描敷贴器上的二维码。"
          }
        }
      }
    },
    "Try NFC Again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试 NFC"
          }
        }
      }
    },
    "Wake with NFC" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 NFC 唤醒"
          }
        }
      }
    },
    "NFC signal sent. Looking for the sensor's Bluetooth signal…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发送 NFC 信号，正在查找传感器的蓝牙信号…"
          }
        }
      }
    },
    "NFC was cancelled. You can try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已取消 NFC 扫描。你可以重试。"
          }
        }
      }
    },
    "NFC couldn't wake the sensor. Try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法通过 NFC 唤醒传感器，请重试。"
          }
        }
      }
    },
    "NFC signal sent. Keep the iPhone near the sensor." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发送 NFC 信号。请让 iPhone 保持靠近传感器。"
          }
        }
      }
    },
    "Looking for the sensor's Bluetooth signal…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在查找传感器的蓝牙信号…"
          }
        }
      }
    },
    "The scanned sensor is awake. Confirm it is yours." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在蓝牙中找到扫码选中的传感器，请确认是你要配对的设备。"
          }
        }
      }
    },
    "Sensor is awake. Confirm it is yours." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已找到这枚传感器，请确认是你要配对的设备。"
          }
        }
      }
    },
    "Bluetooth sensors found. Choose the sensor you just applied." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已找到附近的蓝牙传感器，请选择刚贴上的那枚。"
          }
        }
      }
    },
    "This iPhone can't read NFC tags." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 无法读取 NFC 标签。"
