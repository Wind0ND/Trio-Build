    "Is this your sensor?" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是您的传感器吗？"
          }
        }
      }
    },
    "No sensors heard. The sensor advertises in bursts. Try scanning again." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未发现传感器。传感器会间歇广播，请重新搜索。"
          }
        }
      }
    },
    "Previously used, can't be re-paired" : {
      "extractionState" : "manual",
