    "%@ can't reach this sensor yet. It can only talk to one app at a time, so force-quit the official Ottai app (swipe it away in the app switcher) to let %@ connect." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
