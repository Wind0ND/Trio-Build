    },
    "The sensor can only talk to one app at a time. Force-quit the official Ottai app (swipe it away in the app switcher) before continuing, or %@ won't be able to connect." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传感器一次只能与一个应用通信。继续前，请在应用切换器中向上轻扫，强制关闭欧态官方应用。否则 %@ 无法连接。"
          }
        }
      }
