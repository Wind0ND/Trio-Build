    },
    "Are you sure you want to stop using the Ottai Ultra? Your Ottai account stays signed in, and sensor history is kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要停止使用 Ottai Ultra 吗？您的欧态账户仍会保持登录，传感器历史记录也会保留。"
          }
        }
      }
    },
    "Confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认"
          }
        }
      }
    },
    "End Sensor" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束传感器会话"
          }
        }
      }
    },
    "This shuts the sensor down and releases it from your Ottai account. You cannot reverse this action or reuse the sensor. Remove it from your arm afterwards." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会关闭传感器，并解除它与您欧态账户的关联。此操作无法撤销，传感器也无法再次使用。完成后请从上臂取下传感器。"
          }
        }
      }
    },
    "Could Not Confirm Shutdown" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认是否已关闭"
          }
        }
      }
    },
    "Trio could not reach the sensor to confirm it powered down. It may still be transmitting nearby, or it may already be off the air for good. Ending the session now releases it from your account without that confirmation." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 无法连接传感器以确认它已关闭。它可能仍在附近发送信号，也可能已经永久停止发送信号。现在结束会话会解除传感器与账户的关联，即使无法确认它是否已关闭。"
          }
        }
      }
    },
    "End Anyway" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
