            "value" : "更换传感器"
          }
        }
      }
    },
    "Scan Applicator" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描敷贴器"
          }
        }
      }
    },
    "Search Nearby" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索附近设备"
          }
        }
      }
    },
    "Pair" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对"
          }
        }
      }
    },
    "Scan Again" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新搜索"
          }
        }
      }
    },
    "My sensor isn't listed" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表中没有我的传感器"
          }
        }
      }
    },
    "Scan Applicator Instead" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改为扫描敷贴器"
          }
        }
      }
    },
    "Camera Access Is Off" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机权限已关闭"
          }
        }
      }
    },
    "Open Settings" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开设置"
          }
        }
      }
    },
    "Allow camera access in Settings to scan the applicator, or search for sensors nearby instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置中允许使用相机以扫描敷贴器，或改为搜索附近的传感器。"
          }
        }
      }
    },
    "Step 1" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 1 步"
          }
        }
      }
    },
    "Choose the back of your upper arm as the application site. Avoid areas with scars, moles, stretch marks, or lumps." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择上臂后侧作为贴敷部位，避开疤痕、痣、拉伸纹和硬块。"
          }
        }
      }
    },
    "Note" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意"
          }
        }
      }
    },
    "For optimal monitor performance, please select a site:" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为获得最佳监测效果，请按以下要求选择贴敷部位："
          }
        }
      }
    },
    "Without scars, moles, stretch marks, or lumps." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择没有疤痕、痣、拉伸纹或硬块的部位。"
          }
        }
      }
    },
    "Avoid bony areas and irritated skin." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避开骨骼突出部位和有刺激症状的皮肤。"
          }
        }
      }
    },
    "Generally stays flat during your normal daily activities, avoiding any bending or folding." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择在日常活动中通常能保持平坦、不易弯折或产生褶皱的部位。"
          }
        }
      }
    },
    "At least 2.5 cm (1 inch) away from an insulin injection site." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距离胰岛素注射部位至少 2.5 cm（1 英寸）。"
          }
        }
      }
    },
    "Select a different site from the one most recently used to prevent discomfort or skin irritation." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择与上次不同的部位，以减少不适或皮肤刺激。"
          }
        }
      }
    },
    "Consider shaving the area to ensure a snug fit." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以考虑剃去该部位的毛发，使传感器贴合。"
          }
        }
      }
    },
    "Step 2" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 2 步"
          }
        }
      }
    },
    "Clean the application site and wait for the skin to dry before proceeding." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清洁贴敷部位，等皮肤干燥后再继续。"
          }
        }
      }
    },
    "The application site MUST be sufficiently clean and dry to make the Monitor adhere securely to the skin." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴敷部位必须充分清洁和干燥，以确保传感器牢牢贴在皮肤上。"
          }
        }
      }
    },
    "Clean the skin using soap and wait to dry before sanitizing the application site with alcohol pads. Allow the site to air-dry before proceeding." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用肥皂清洗皮肤，待其干燥后，用酒精棉片为贴敷部位消毒。等其自然晾干后再继续。"
          }
        }
      }
    },
    "Step 3" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 3 步"
          }
        }
      }
    },
    "Rotate to open the bottom cover of the Applicator." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旋开敷贴器底盖。"
          }
        }
      }
    },
    "Caution" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意"
          }
        }
      }
    },
    "Do NOT use if the Applicator is opened or damaged before use. The needle is sterile unless the Applicator has been opened or damaged." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如敷贴器在使用前已经打开或损坏，请勿使用。只有敷贴器完好且未打开时，才能保证针头无菌。"
          }
        }
      }
    },
    "Do NOT put the cover back on as it may damage the Monitor." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请勿重新盖上底盖，以免损坏传感器。"
          }
        }
      }
    },
    "Do NOT touch inside the Applicator as it contains a needle." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敷贴器内有针头，请勿触摸内部。"
          }
        }
      }
    },
    "Do NOT apply it if the expiry date has passed." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已超过有效期，请勿使用。"
          }
        }
      }
    },
    "Step 4" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 4 步"
          }
        }
      }
    },
    "Place the Applicator over your arm, press the launch button on the top, and gently pull away the Applicator. The Monitor should now be attached to the skin." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将敷贴器放在上臂，按下顶部的释放按钮，然后轻轻移开敷贴器。此时传感器应已贴在皮肤上。"
          }
        }
      }
    },
    "Hold the Applicator flat against your arm and make sure the bottom edge is fully adhered to the skin, or application failure may occur." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让敷贴器平贴上臂，确保底部边缘与皮肤完全接触，否则可能贴敷失败。"
          }
        }
      }
    },
    "Before removing the Applicator, keep holding the Applicator against your arm for a few seconds. This can help the adhesive stick to your skin." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移开敷贴器前，请将它在上臂上多按住几秒。这有助于胶贴与皮肤贴合。"
          }
        }
      }
    },
    "Applying the Monitor may cause bleeding. If bleeding occurs," : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴敷传感器时可能出血。如果出血，"
          }
        }
      }
    },
    "Wipe away the blood with a cotton swab." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请用棉签擦去血液。"
          }
        }
      }
    },
    "If necessary, use a cotton swab to press on the small opening on the Monitor or apply ice packs to help stop the bleeding." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要时，用棉签按压传感器上的小孔，或用冰袋帮助止血。"
          }
        }
      }
    },
    "Remove the Monitor and apply a new one at a different site only if bleeding does not stop." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在出血无法止住时，才移除传感器并在另一处贴敷新的传感器。"
          }
        }
      }
    },
    "Step 5" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 5 步"
          }
        }
      }
    },
    "Gently press the tape around the edge of the Monitor to attach it firmly to the skin." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻按传感器边缘周围的胶贴，使它牢固贴在皮肤上。"
          }
        }
      }
    },
    "Discard the used Applicator following local guidelines for disposal of blood and bodily fluid contact parts." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照当地有关处置接触血液和体液物品的规定，丢弃用过的敷贴器。"
          }
        }
      }
    },
    "Back" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回"
          }
        }
      }
    },
    "Next" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一步"
          }
        }
      }
    },
    "Done" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成"
          }
        }
      }
    },
    "Your sensor is registered to your Ottai account when you pair it, and released when you end it, whichever you choose below. That is how pairing works and cannot be turned off. Everything beyond it is up to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论选择以下哪一项，配对时都会将传感器注册到您的欧态账户，结束会话时则会解除关联。这是配对所必需的流程，无法关闭。其余共享内容由您决定。"
          }
        }
      }
    },
    "You can change this at any time in Account settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以随时在账户设置中更改此选项。"
          }
        }
      }
    },
    "What do you share with Ottai?" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您将向欧态共享哪些数据？"
          }
        }
      }
    },
    "Log Out" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出登录"
          }
        }
      }
    },
    "You'll need to sign in again to pair a new sensor or resume data sharing. Your current sensor keeps working." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对新传感器或恢复数据共享前，您需要重新登录。当前传感器会继续工作。"
          }
        }
      }
    },
    "Signed in until" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录有效期至"
          }
        }
      }
    },
    "Session" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话"
          }
        }
      }
    },
    "Logged in elsewhere. Telemetry is paused until you sign in again." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
