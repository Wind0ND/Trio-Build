        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始之前"
          }
        }
      }
    },
    "Apply the sensor and sign in to your %@ account. Then, you can activate the sensor and read from it directly in the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴上传感器并登录您的 %@ 账户，然后即可在应用中激活传感器并直接接收读数。"
          }
        }
      }
    },
    "Continue" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续"
          }
        }
      }
    },
    "Find your sensor" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找传感器"
          }
        }
      }
    },
    "Scan the QR code on the sensor applicator, or search for sensors nearby." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描传感器敷贴器上的二维码，或搜索附近的传感器。"
          }
        }
      }
    },
    "Please be patient" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请稍候"
          }
        }
      }
    },
    "Keep your phone near the sensor. This can take up to a minute." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将手机靠近传感器。此过程最长可能需要一分钟。"
          }
        }
      }
    },
    "Scanned sensor" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已扫描的传感器"
          }
        }
