        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已找到传感器"
          }
        }
      }
    },
    "Change Sensor" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
