        }
      }
    },
    "The diagnostics export records connection stages and outcomes. This test ends before glucose retrieval." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断导出会记录连接阶段和结果。本次测试做到蓝牙服务检查为止。"
          }
        }
      }
    },
    "Scan the package code or enter the code printed on the box." : {
      "extractionState" : "manual",
      "localizations" : {
