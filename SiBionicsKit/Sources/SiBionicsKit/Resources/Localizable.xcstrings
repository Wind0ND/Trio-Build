{
  "sourceLanguage" : "en",
  "strings" : {
    "Found Bluetooth service FF30 and characteristic FF31. Device model is unverified." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已找到蓝牙服务 FF30 和特征 FF31。设备型号尚未验证。"
          }
        }
      }
    },
    "No exact Bluetooth name matched. Check the complete name and keep the sensor nearby." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到蓝牙名称完全匹配的设备。请核对完整名称，并让传感器靠近手机。"
          }
        }
      }
    },
    "Sibionics GS1 Connection Test" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硅基动感 GS1 连接测试"
          }
        }
      }
    },
    "Use a spare or test sensor. This check connects briefly and looks for the GS1 Bluetooth service." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用备用或测试传感器。测试会短暂连接传感器，检查 GS1 蓝牙服务。"
          }
        }
      }
    },
    "If another app is connected to the test sensor, close that app from the app switcher before starting." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果其他 App 正连接这枚测试传感器，请先从 App 切换器关闭那个 App。"
          }
        }
      }
    },
    "Connection Code or Serial" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接码或序列号"
          }
        }
      }
    },
    "Stop Test" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止测试"
